# Copy to .env and adjust. Never commit real secrets.
#
# For docker-compose.prod.yml set DOMAIN and a real DJANGO_SECRET_KEY.
# Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"

# Public hostname without https:// (used by Caddy and the production compose file)
DOMAIN=stocksight.example.com

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=stocksight.example.com,www.stocksight.example.com,localhost,127.0.0.1

# TLS terminates at Caddy/nginx in production. The production compose file
# sets these automatically; leave them commented for plain local development.
# SECURE_SSL_REDIRECT=True
# CSRF_TRUSTED_ORIGINS=https://stocksight.example.com,https://www.stocksight.example.com

# Optional: Postgres in production (otherwise SQLite is used)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=stocksight
# DB_USER=stocksight
# DB_PASSWORD=secret
# DB_HOST=db
# DB_PORT=5432

# Where local OHLCV CSVs and trained model artifacts live
MARKET_DATA_DIR=data/market
MARKET_UNIVERSE_CSV=all_stockss.csv
NEWS_DIR=data/news

# Refresh at most once per symbol per N hours (auto-refresh on page load)
MARKET_REFRESH_TTL_HOURS=1

# Pause all remote fetches for N seconds after a provider 401/429 failure.
MARKET_ERROR_COOLDOWN_SECONDS=300

# Re-fetch stock news after N hours (default 6)
NEWS_TTL_HOURS=6

# Optional: richer news coverage (keyless Yahoo/Google feeds always run)
# FINNHUB_API_KEY=your_key_here
# NEWS_API_KEY=your_key_here

LOG_LEVEL=INFO

# Per-IP rate limits are enabled by default. The default cache is in-process;
# for multi-worker deployments configure a shared Redis cache in settings.py.
RATE_LIMIT_ENABLED=True

# Set to a long random value in production (DEBUG=False refuses the dev default).
# DJANGO_SECRET_KEY=<generate with the command above>
