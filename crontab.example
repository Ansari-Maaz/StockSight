# Install with: crontab crontab.example
# Adjust the path and python binary to match your deployment.
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin

# Refresh cached OHLCV data every weekday at 18:30 UTC (after US market close)
30 18 * * 1-5 cd /path/to/MarketMind && /path/to/MarketMind/.venv/bin/python manage.py refresh_data >> /var/log/marketmind-refresh.log 2>&1

# Rebuild models once a week for the default watchlist (optional)
0 19 * * 0 cd /path/to/MarketMind && /path/to/MarketMind/.venv/bin/python manage.py train_model AAPL --offline >> /var/log/marketmind-train.log 2>&1
